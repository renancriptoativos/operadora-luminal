# Envio real de e-mail (SMTP). Sem SMTP_HOST, o app mantém a caixa de entrada demo.
# Gmail: ative a verificação em duas etapas e crie uma "senha de app" em
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM="Luminal <seuemail@gmail.com>"

# URL pública usada no link de confirmação enviado por e-mail (opcional).
PUBLIC_URL=http://127.0.0.1:3000

# Sincronização entre instâncias (desativada enquanto SYNC_API_KEY estiver vazia).
# Use a mesma chave (mínimo 16 caracteres) nos dois servidores.
SYNC_API_KEY=chave-longa-e-aleatoria-com-16-ou-mais-caracteres

# Apenas no servidor de destino: URL do servidor de origem e chave dele.
# Se SYNC_SOURCE_KEY ficar vazio, usa a SYNC_API_KEY local.
SYNC_SOURCE_URL=https://origem.exemplo.com
SYNC_SOURCE_KEY=chave-do-servidor-de-origem
